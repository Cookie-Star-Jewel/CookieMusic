{
  "name": "cookie-music",
  "productName": "CookieMusic",
  "version": "0.4.32",
  "private": true,
  "description": "CookieMusic —— 基于 Electron + Next.js 的桌面音乐播放器，带隧道歌词与本地曲库管理。",
  "author": "CookieMusic Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cookie-Star-Jewel/CookieMusic.git"
  },
  "homepage": "https://github.com/Cookie-Star-Jewel/CookieMusic",
  "bugs": {
    "url": "https://github.com/Cookie-Star-Jewel/CookieMusic/issues"
  },
  "keywords": [
    "music-player",
    "electron",
    "nextjs",
    "desktop-app",
    "local-library",
    "lyrics",
    "tunnel-lyrics",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "electron:dev": "cross-env ELECTRON_DEV_URL=http://localhost:3000 electron electron/main.cjs",
    "clean:release": "node scripts/clean-release.cjs release/",
    "electron:build": "npm run build && npm run prepare:standalone && npm run clean:release && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "animal-island-ui": "^1.13.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "opencc-js": "^1.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
